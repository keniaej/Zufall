# Kopiert diese Datei nach .env und tragt eure echten Werte ein.
# Die .env-Datei wird NICHT zu GitHub hochgeladen.

# API-Keys der Ausschreibungsportale (Namen anpassen, sobald ihr die Portale festgelegt habt)
BEISPIEL_QUELLE_API_KEY=

# Optional: API-Key für das KI-Modell (z. B. zum Zusammenfassen oder Filtern)
KI_API_KEY=

# Suchbegriffe, kommagetrennt
SUCHBEGRIFFE=IT-Dienstleistung,Software
